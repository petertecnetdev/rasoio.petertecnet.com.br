    "@capacitor/core": "^7.4.0",
    "@react-oauth/google": "^0.12.2",
    "axios": "^1.11.0",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.4",
    "dayjs": "^1.11.19",
    "framer-motion": "^12.4.2",
    "luxon": "^3.7.2",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.2",
    "react-bootstrap-icons": "^1.11.6",
    "react-chartjs-2": "^5.2.0",
