{
  "name": "rasoio",
  "version": "1.0.0",
  "private": true,
  "description": "Rasoio - gestão, descoberta e agendamento para estabelecimentos, profissionais e clientes.",
  "homepage": "/",
  "scripts": {
    "start": "react-scripts start",
    "build": "node scripts/build.js",
